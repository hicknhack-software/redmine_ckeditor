<p>
  <%= content_tag :label, l(:ckeditor_ui_color) %>
  <%= color_field_tag 'settings[ui_color]', RedmineCkeditorSetting.ui_color %>
</p>
<p>
  <%= content_tag :label, l(:ckeditor_width) %>
  <%= text_field_tag 'settings[width]', RedmineCkeditorSetting.width, placeholder: '100%' %>
</p>
<p>
  <%= content_tag :label, l(:ckeditor_height) %>
  <%= number_field_tag 'settings[height]', RedmineCkeditorSetting.height, min: 120, max: 1200 %>
</p>
<p>
  <%= content_tag :label, l(:ckeditor_startup_show_blocks) %>
  <%= hidden_field_tag 'settings[show_blocks]', '0' %>
  <%= check_box_tag 'settings[show_blocks]', '1', RedmineCkeditorSetting.show_blocks? %>
</p>
<p>
  <%= content_tag :label, l(:ckeditor_group_toolbar_items) %>
  <%= hidden_field_tag 'settings[toolbar_can_collapse]', '0' %>
  <%= check_box_tag 'settings[toolbar_can_collapse]', '1', RedmineCkeditorSetting.group_toolbar_items? %>
  <em class="info"><%= l(:ckeditor_group_toolbar_items_help) %></em>
</p>
<p>
  <%= content_tag :label, l(:ckeditor_toolbar_buttons) %>
  <%= text_area_tag 'settings[toolbar]', RedmineCkeditorSetting.toolbar_string, rows: 5, cols: 80 %>
  <em class="info"><%= l(:ckeditor_toolbar_help) %></em>
</p>
<p class="info"><%= l(:ckeditor_license_notice) %></p>
