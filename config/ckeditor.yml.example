# CKEditor 5 configuration. Copy this file to REDMINE_ROOT/config/ckeditor.yml.
# The plugin defaults to the GPL-compatible self-hosted license key. Replace it
# with your commercial self-hosting key when applicable.
licenseKey: GPL

# Any CKEditor 5 configuration can be supplied here. Ruby-specific sanitizer
# settings are kept separate below.
mediaEmbed:
  previewsInData: true
htmlSupport:
  allow:
    - name: "$all"
      attributes: true
      classes: true
      styles: true

# CKEditor 5 replaces CKEditor 4's built-in Styles list with explicit style
# definitions. Add `style` to the toolbar when definitions are configured.
style:
  definitions:
    - name: Info paragraph
      element: p
      classes:
        - info
    - name: Inline marker
      element: span
      classes:
        - marker

allowedProtocols:
  - http
  - https
  - ftp
  - mailto
  - ssh
  - sftp

# Extend these lists if custom CKEditor features emit additional HTML.
allowedTags:
  - a
  - blockquote
  - br
  - code
  - div
  - figcaption
  - figure
  - h1
  - h2
  - h3
  - h4
  - h5
  - h6
  - hr
  - iframe
  - img
  - li
  - ol
  - p
  - pre
  - span
  - strong
  - table
  - tbody
  - td
  - tfoot
  - th
  - thead
  - tr
  - ul
allowedAttributes:
  - alt
  - class
  - colspan
  - height
  - href
  - id
  - rel
  - rowspan
  - src
  - srcset
  - style
  - target
  - title
  - width
